# Cloudflare Pages — 헤더 설정
# 정적 자산 캐시 + 보안 헤더
#
# 참조:
#   - https://developers.cloudflare.com/pages/configuration/headers/
#   - https://owasp.org/www-project-secure-headers/

# ════════════════════════════════════════════════════════════
# 전 페이지 공통 — 보안 기본
# ════════════════════════════════════════════════════════════
/*
  # MIME 스니핑 차단
  X-Content-Type-Options: nosniff

  # iframe 임베드는 동일 출처만
  X-Frame-Options: SAMEORIGIN

  # 구형 XSS 필터는 끔 — 오히려 정보 유출에 악용될 수 있어 OWASP가 0을 권장 (CSP가 대신 막음)
  X-XSS-Protection: 0

  # 외부 링크 클릭 시 레퍼러 최소화
  Referrer-Policy: strict-origin-when-cross-origin

  # 사용 안 하는 브라우저 권한 명시적으로 차단 (payment는 결제창 때문에 자기 사이트만 허용)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self), usb=(), serial=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()

  # 플래시·PDF 플러그인의 교차 도메인 정책 파일 차단
  X-Permitted-Cross-Domain-Policies: none

  # HTTPS 강제 (1년) — 한 번 방문 후엔 HTTP 요청 자체가 막힘
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 외부 창과 격리 (Spectre 공격 완화)
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # 리소스 임베드 정책
  Cross-Origin-Resource-Policy: same-site

  # 콘텐츠 보안 정책 (CSP) — 외부 스크립트/스타일 화이트리스트
  # NOAH가 사용하는 CDN: Tailwind, Pretendard, Google Fonts, Apps Script
  # 방문 분석: GA4, Microsoft Clarity·광고 픽셀(assets/js/tags.js가 불러옴 — 도구 주소는 tools/sync_tags.py가 관리), Cloudflare Web Analytics
  # ※ 포트원 채널(PG) 확정 후 해당 PG 도메인을 frame-src·form-action·connect-src 에 추가할 것
  #    예) 토스페이먼츠 https://*.tosspayments.com / KG이니시스 https://*.inicis.com / NHN KCP https://*.kcp.co.kr
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.portone.io https://*.portone.io https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://static.cloudflareinsights.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.portone.io https://script.google.com https://script.googleusercontent.com https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://cloudflareinsights.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://www.googletagmanager.com https://*.portone.io; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com https://*.portone.io; frame-ancestors 'self'; upgrade-insecure-requests

# ════════════════════════════════════════════════════════════
# 정적 자산 — 1년 immutable 캐시
# ════════════════════════════════════════════════════════════
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# 폰트 — 파일 내용이 바뀌지 않으므로 1년 캐시 (CSS는 ?v= 해시로 갱신)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 검색엔진 소유 확인 파일 — 캐시 짧게 (재확인 시 최신값)
/BingSiteAuth.xml
  Cache-Control: public, max-age=3600

# IndexNow 키 파일 — 검색엔진이 수시로 확인
/d1ebd682684f953fad9c2a85b7c238bf.txt
  Cache-Control: public, max-age=3600

# ════════════════════════════════════════════════════════════
# 소개서 PDF — 짧은 캐시 + 다운로드 강제
# ════════════════════════════════════════════════════════════
/assets/brochure/*.pdf
  Cache-Control: public, max-age=3600
  Content-Disposition: attachment; filename="NOAH_brochure.pdf"
  X-Content-Type-Options: nosniff

# ════════════════════════════════════════════════════════════
# HTML — 캐시 끔 (콘텐츠 변경 즉시 반영)
# ════════════════════════════════════════════════════════════
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
